Algoritmo PerimetroRectangulo
		
		// Definir variables
		Definir base, altura, perimetro Como Real
		
		// Inicializar variables
		base <- 0
		altura <- 0
		perimetro <- 0
		
		// Solicitar datos
		Escribir "Ingrese la base del rectangulo:"
		Leer base
		
		Escribir "Ingrese la altura del rectangulo:"
		Leer altura
		
		// Procesar calculo
		perimetro <- 2 * (base + altura)
		
		// Mostrar resultado
		Escribir "El perimetro del rectangulo es: ", perimetro
		
FinAlgoritmo

