Algoritmo Cubo
	
	// Definir variables
	Definir lado, areaCara, volumen Como Real
	
	// Inicializar variables
	lado <- 0
	areaCara <- 0
	volumen <- 0
	
	// Solicitar datos
	Escribir "Ingrese la longitud del lado del cubo:"
	Leer lado
	
	// Procesar calculos
	areaCara <- lado * lado
	volumen <- lado * lado * lado
	
	// Mostrar resultados
	Escribir "El area de una cara del cubo es: ", areaCara
	Escribir "El volumen total del cubo es: ", volumen
	
FinAlgoritmo
