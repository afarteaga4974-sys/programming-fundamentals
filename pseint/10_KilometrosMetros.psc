Algoritmo KilometrosMetros
	
	// Definir variables
	Definir kilometros, metros Como Real
	
	// Inicializar variables
	kilometros <- 0
	metros <- 0
	
	// Solicitar datos
	Escribir "Ingrese la distancia en kilometros:"
	Leer kilometros
	
	// Procesar calculo
	metros <- kilometros * 1000
	
	// Mostrar resultado
	Escribir kilometros, " kilometros equivalen a ", metros, " metros."
	
FinAlgoritmo