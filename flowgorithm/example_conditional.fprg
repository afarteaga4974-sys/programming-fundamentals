    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="num" type="Integer" array="False" size=""/>
            <assign variable="num" expression="0"/>
            <output expression="&quot;type or enter a number: &quot;" newline="True"/>
            <input variable="num"/>
            <if expression="number &gt;0">
                <then>
                    <output expression="&quot;number greater than zero&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;number less than zero&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
