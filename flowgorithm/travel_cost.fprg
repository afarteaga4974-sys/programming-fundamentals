    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="Days" type="Integer" array="False" size=""/>
            <declare name="total" type="Real" array="False" size=""/>
            <output expression="&quot;enter a days&quot;" newline="True"/>
            <input variable="Days"/>
            <if expression="Days&gt;7">
                <then>
                    <output expression="&quot;total is: &quot; &amp; (Days * 50) * 0.90" newline="True"/>
                </then>
                <else>
                    <if expression="days&lt;=0">
                        <then>
                            <output expression="&quot;invalid enter a valid days&quot;" newline="True"/>
                        </then>
                        <else>
                            <output expression="&quot;total is: &quot; &amp; Days * 50" newline="True"/>
                        </else>
                    </if>
                </else>
            </if>
        </body>
    </function>
