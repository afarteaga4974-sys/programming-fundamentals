<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="ticket_discount"/>
        <attribute name="authors" value="Lab Programacion"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-10-15 09:42:02 a.&#8239;m."/>
        <attribute name="created" value="TGFiIFByb2dyYW1hY2lvbjtFUVVJUE8tMTA4OzIwMjYtMTAtMTQ7MTA6NDE6MTIgYS7igK9tLjsxMTg2Nw=="/>
        <attribute name="edited" value="TGFiIFByb2dyYW1hY2lvbjtFUVVJUE8tMTA4OzIwMjYtMTAtMTU7MDk6NDI6MDIgYS7igK9tLjs3OzExOTkw"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="purchase" type="Real" array="False" size=""/>
            <declare name="total" type="Real" array="False" size=""/>
            <assign variable="purchase" expression="0"/>
            <assign variable="total" expression="0"/>
            <output expression="&quot;record purchase&quot;" newline="True"/>
            <input variable="purchase"/>
            <if expression="purchase&gt;100">
                <then>
                    <output expression="&quot;total is: &quot;&amp; purchase*0.85" newline="True"/>
                </then>
                <else>
                    <if expression="purchase&lt;=100">
                        <then>
                            <output expression="&quot;total is: &quot; &amp; purchase" newline="True"/>
                        </then>
                        <else>
                            <output expression="&quot;ingrese valor valido&quot;" newline="True"/>
                        </else>
                    </if>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
