<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="login_acces"/>
        <attribute name="authors" value="Lab Programacion"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-10-15 11:48:33 a.&#8239;m."/>
        <attribute name="created" value="TGFiIFByb2dyYW1hY2lvbjtFUVVJUE8tMTA4OzIwMjYtMTAtMTU7MTE6Mzc6MDQgYS7igK9tLjsxMTg3NQ=="/>
        <attribute name="edited" value="TGFiIFByb2dyYW1hY2lvbjtFUVVJUE8tMTA4OzIwMjYtMTAtMTU7MTE6NDg6MzMgYS7igK9tLjs0OzExOTkw"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="username" type="String" array="False" size=""/>
            <declare name="password" type="String" array="False" size=""/>
            <assign variable="username" expression="&quot;administrador&quot;"/>
            <assign variable="password" expression="&quot;admin1234&quot;"/>
            <output expression="&quot;enter a username&quot;" newline="True"/>
            <input variable="username"/>
            <output expression="&quot;enter a password&quot;" newline="True"/>
            <input variable="password"/>
            <if expression="username == &quot;administrador&quot;">
                <then>
                    <output expression="&quot;acces granted&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;acces denied&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
